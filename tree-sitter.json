{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "amber",
      "camelcase": "Amber",
      "scope": "source.amber",
      "path": ".",
      "file-types": [
        "ab"
      ],
      "injection-regex": "^amber$"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Amber grammar for tree-sitter",
    "authors": [
      {
        "name": "Paweł Karaś"
      }
    ],
    "links": {
      "repository": "https://github.com/amber-lang/tree-sitter-amber"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "kotlin": false,
    "odin": false,
    "zig": false
  }
}
